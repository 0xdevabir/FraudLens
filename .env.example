# Optional variables for docker compose (copy to `.env` next to docker-compose.yml).
# backend/.env is separate and is created by `make demo` / scripts/demo.*

# Postgres password used by the postgres service and by the api service URL.
# POSTGRES_PASSWORD=fraudlens_dev

# Redis password. Unset = no auth (port is loopback-only). When set, also put the
# same value into FRAUDLENS_REDIS_URL in backend/.env for host-side development.
# REDIS_PASSWORD=

# Where the browser finds the API. Baked into the console image at build time.
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8010
