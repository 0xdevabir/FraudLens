# Copy to .env (never committed). Every setting is in src/fraudlens/config.py.

# Password given to the demo accounts by `make seed` (at least 12 characters).
# Leave unset to have one generated per account and printed once.
FRAUDLENS_SEED_PASSWORD=

# One-click sign-in buttons on the console's login page: anyone who can reach the
# API becomes any demo account without a password. For a demo on your own machine
# only; the API refuses to start with it in production.
# FRAUDLENS_DEMO_LOGIN=true

# Signing key for access tokens (`openssl rand -hex 32`). Required when
# FRAUDLENS_ENVIRONMENT=production: the API refuses to start with the development
# key, the development database password, a Redis URL without a password, or "*"
# as a CORS origin.
# FRAUDLENS_ENVIRONMENT=production
# FRAUDLENS_JWT_SECRET=
# FRAUDLENS_CORS_ORIGINS=["https://console.example"]

# The defaults are the containers `make up` starts.
# FRAUDLENS_DATABASE_URL=postgresql+psycopg://fraudlens:fraudlens_dev@127.0.0.1:5433/fraudlens
# FRAUDLENS_REDIS_URL=redis://127.0.0.1:6380/0

# A Postgres on the host instead (then `make redis`, not `make up`). The role needs
# CREATEDB for the tests, which make and drop a database of their own.
# FRAUDLENS_DATABASE_URL=postgresql+psycopg://fraudlens:<password>@127.0.0.1:5432/fraudlens

# A Redis password: put REDIS_PASSWORD=<password> in a .env next to
# docker-compose.yml, and the same password here.
# FRAUDLENS_REDIS_URL=redis://:<password>@127.0.0.1:6380/0

# Case notes written by a language model instead of the template. Providers with a
# key are tried in this order; the first gets several attempts per note, the others
# one each (docs/DECISION_POLICY.md §7). With no key below, ANTHROPIC_API_KEY (Claude).
# FRAUDLENS_LLM_NOTES=true
# FRAUDLENS_LLM_PROVIDERS=["nova","gemini","groq","openrouter"]
# FRAUDLENS_NOVA_API_KEY=
# FRAUDLENS_GEMINI_API_KEY=
# FRAUDLENS_GROQ_API_KEY=
# FRAUDLENS_OPENROUTER_API_KEY=
# FRAUDLENS_LLM_PRIMARY_ATTEMPTS=3
# FRAUDLENS_LLM_ATTEMPT_TIMEOUT_SECONDS=25
# FRAUDLENS_LLM_DEADLINE_SECONDS=120
# Models (defaults shown): FRAUDLENS_NOVA_MODEL=nova_g, FRAUDLENS_GEMINI_MODEL=gemini-3.8-flash,
# FRAUDLENS_GROQ_MODEL=openai/gpt-oss-120b,
# FRAUDLENS_OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# A challenger that scores every transaction next to the served model and decides
# nothing (`make retrain` registers one). Compare them on the console's model page.
# FRAUDLENS_SHADOW_MODEL_VERSION=v3
# Serve this version instead of the promoted one (normally leave unset).
# FRAUDLENS_MODEL_VERSION=v2

# Reviewer deadlines: how often the worker records cases past their review deadline (0:
# never), and whether such a case is also escalated to the supervisors.
# FRAUDLENS_SLA_SWEEP_SECONDS=60
# FRAUDLENS_SLA_AUTO_ESCALATE=true

# Webhooks and customer SMS. Webhook URLs must be public https unless this is set (for
# local testing only). SMS is off, logs only (`console`), or posts to a gateway (`http`).
# FRAUDLENS_WEBHOOK_ALLOW_PRIVATE=true
# FRAUDLENS_NOTIFY_ADAPTER=http
# FRAUDLENS_SMS_GATEWAY_URL=https://sms.example.com/send
# FRAUDLENS_SMS_GATEWAY_TOKEN=
